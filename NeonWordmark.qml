import QtQuick
// qmllint: style-only hints switched off for this file (see "Editor diagnostics" in CLAUDE.md)
// qmllint disable unqualified
import QtQuick.Effects

// Neon "TOPAZ JUKEBOX" lettering (TopBar, About dialog): two SVGs, one per
// word, sharing one coordinate system so side by side they line up exactly,
// with the letters as outlines -- no font needed, identical on Windows and
// Linux. Generated by tools/generate-wordmark.py. Each word gets its own glow
// colour (one MultiEffect has one colour -- the reason for two files); the
// glow can't live in the SVG itself, Qt's SVG renderer ignores filters.
Row {
    id: root

    property int wordHeight: 40          // height of each word image (px)
    property real glowOpacity: 1.0       // glow strength (max 1.0), 0 = off
    property int  glowSpread:  40        // blur radius in px (how far it reaches)
    property real glowScale:   1.04      // glow slightly larger than the letters

    spacing: 0

    // One word: the SVG plus a soft glow in its tube colour. MultiEffect's
    // shadow with zero offset and full blur = a glow around the letters; the
    // source is drawn on top. Static content, so the effect renders once, not
    // per frame. Only the height is set: with sourceSize.height Qt rasterizes
    // the SVG at display size (DPR included) and implicitWidth follows its
    // aspect ratio.
    component NeonWord: Item {
        id: neonWord
        property alias source: wordImage.source
        property color glowColor
        implicitWidth:  wordImage.implicitWidth
        implicitHeight: root.wordHeight
        width:  implicitWidth
        height: implicitHeight

        Image {
            id: wordImage
            anchors.fill: parent
            sourceSize.height: root.wordHeight
            fillMode: Image.PreserveAspectFit
            smooth: true
            visible: false
        }
        MultiEffect {
            anchors.fill: wordImage
            source: wordImage
            shadowEnabled: true
            shadowColor: neonWord.glowColor
            shadowOpacity: root.glowOpacity
            shadowBlur: 1.0
            blurMax: root.glowSpread
            shadowScale: root.glowScale
            shadowHorizontalOffset: 0
            shadowVerticalOffset: 0
        }
    }

    NeonWord { source: "qrc:/Topaz/Topaz_Wordmark_Topaz.svg";   glowColor: "#FF4FB8" }
    NeonWord { source: "qrc:/Topaz/Topaz_Wordmark_Jukebox.svg"; glowColor: "#3BE8FF" }
}
