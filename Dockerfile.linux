FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Base toolchain + libraries Qt6/projectM/GLEW need at build time, and that
# a Qt Quick app typically dynamically links against at run time -- separate
# from Qt itself, which comes from an official prebuilt install below.
# Ubuntu 24.04's own apt-packaged Qt6 is 6.4.2 -- confirmed too old the hard
# way (first real build attempt): QQmlApplicationEngine::loadFromModule()
# needs Qt 6.5+, QAudioBufferOutput needs Qt 6.8+, both used by Topaz.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    ca-certificates \
    python3-pip \
    python3-venv \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libx11-dev \
    libxrandr-dev \
    libxrender-dev \
    libxi-dev \
    libxext-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-0 \
    libfontconfig1-dev \
    libfreetype-dev \
    libdbus-1-dev \
    libxcb1-dev \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xkb1 \
    libxcb-xinerama0 \
    libglib2.0-0t64 \
    pulseaudio-utils \
    && rm -rf /var/lib/apt/lists/*

# Official prebuilt Qt 6.10.2 (gcc_64 kit) via aqtinstall -- matches the
# Windows build's own pinned Qt version (see CLAUDE.md's Build section),
# rather than chasing whatever Qt6 version Ubuntu's own repos happen to carry.
RUN pip3 install --break-system-packages aqtinstall && \
    python3 -m aqt install-qt linux desktop 6.10.2 linux_gcc_64 \
        -m qtmultimedia qtshadertools \
        -O /opt/qt

ENV CMAKE_PREFIX_PATH=/opt/qt/6.10.2/gcc_64
ENV PATH="/opt/qt/6.10.2/gcc_64/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/qt/6.10.2/gcc_64/lib:${LD_LIBRARY_PATH}"

WORKDIR /src
